{
  "manifest_version": 3,
  "name": "Capital Rift Command Center",
  "version": "0.9.7",
  "description": "Capital Rift Command Center v0.9.7: building-only Scout and Deals results fix.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://play.capitalrift.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://overpass-api.de/*",
    "https://overpass.kumi.systems/*",
    "https://overpass.nchc.org.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Capital Rift Command Center"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.capitalrift.com/*"
      ],
      "js": [
        "scout-tile.js",
        "game-cache.js",
        "room-navigation.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.capitalrift.com/*"
      ],
      "js": [
        "rename-plan.js",
        "shop-metrics.js",
        "region-data.js",
        "scout-survey.js",
        "land-buyer.js",
        "intel-views.js",
        "intel-advisory.js",
        "chat-intel.js",
        "transaction-log.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  }
}
